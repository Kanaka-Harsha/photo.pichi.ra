---
import { Image } from 'astro:assets';
import { photographerBioPhoto } from '../data/photographs';
---

<section class="behind-lens-section" aria-labelledby="behind-lens-heading">
  <div class="container">
    <div class="behind-lens-grid">
      <!-- Portrait / Personal Frame visual -->
      <div class="behind-visual">
        <div class="visual-frame">
          <Image
            src={photographerBioPhoto.src}
            alt={photographerBioPhoto.alt}
            width={900}
            height={1140}
            format="webp"
            quality={88}
            loading="lazy"
            class="behind-img"
          />
          <div class="visual-border" aria-hidden="true"></div>
        </div>
        <div class="visual-caption">
          <span class="caption-label">A Quick Note</span>
          <p class="caption-text">"Still in love with cameras — and keeping them safely away from water tanks now!"</p>
        </div>
      </div>

      <!-- Story Text Content -->
      <div class="behind-content">
        <span class="section-tag">A Little About Me</span>
        <h2 id="behind-lens-heading" class="section-title">Behind the lens.</h2>

        <div class="story-paragraphs">
          <p class="lead-story">
            Photography has been my favorite hobby for the past 1 to 2 years. It's my way to unplug, explore new places, and just enjoy the moment.
          </p>
          <p>
            I don't own an expensive DSLR or mirrorless camera yet. Whenever I travel or head out for a weekend shoot, I just rent a camera and a couple of lenses. It's actually great because I get to experiment with telephoto lenses for birds one week, and wide lenses for landscapes the next.
          </p>
          <p>
            After every shoot, I love sitting down with Lightroom and Photoshop. I'm learning how to bring out warm sunrise tones, soft greens, and natural contrast without making photos look fake or over-processed.
          </p>
          <p class="text-muted">
            This site is just my personal scrapbook. No big claims or awards — just honest shots from someone who genuinely loves holding a camera.
          </p>
        </div>

        <div class="behind-actions">
          <a href="/about/" class="btn btn-secondary">
            <span>Read my full story</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .behind-lens-section {
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-4xl);
    background-color: var(--bg-primary);
  }

  .behind-lens-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 900px) {
    .behind-lens-grid {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--space-3xl);
    }
  }

  /* Visual frame */
  .behind-visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 480px;
    margin: 0 auto;
  }

  .visual-frame {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--bg-secondary);
  }

  .behind-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .visual-border {
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(245, 243, 236, 0.45);
    pointer-events: none;
    border-radius: var(--radius-sm);
  }

  .visual-caption {
    padding: var(--space-sm) var(--space-xs);
    border-left: 2px solid var(--accent-olive);
  }

  .caption-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-forest);
    display: block;
  }

  .caption-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.98rem;
    color: var(--text-muted);
    margin-top: 2px;
  }

  /* Story Content */
  .behind-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .section-tag {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-olive);
  }

  .section-title {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    color: var(--text-primary);
    line-height: 1.1;
  }

  .story-paragraphs {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .lead-story {
    font-size: 1.18rem;
    line-height: 1.65;
    color: var(--text-primary);
  }

  .story-paragraphs p {
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .behind-actions {
    margin-top: var(--space-sm);
  }
</style>
