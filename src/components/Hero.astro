---
import { Image } from 'astro:assets';
import { heroPhotograph } from '../data/photographs';
import { siteConfig } from '../data/site';
---

<section class="hero-section" aria-label="Hero photography presentation">
  <div class="hero-image-container">
    <Image
      src={heroPhotograph.src}
      alt={heroPhotograph.alt}
      width={2200}
      height={1300}
      format="webp"
      quality={90}
      loading="eager"
      fetchpriority="high"
      class="hero-image"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
  </div>

  <div class="container hero-content-wrapper">
    <div class="hero-content">
      <div class="hero-eyebrow">
        <span class="eyebrow-line" aria-hidden="true"></span>
        <span class="eyebrow-text">Nature &amp; Wildlife Journal</span>
      </div>

      <h1 class="hero-title">{siteConfig.taglines.hero}</h1>

      <p class="hero-subtitle">{siteConfig.taglines.heroSub}</p>

      <div class="hero-actions">
        <a href="/gallery/" class="btn btn-primary">
          <span>Explore photographs</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/about/" class="btn btn-secondary hero-btn-secondary">
          <span>About the photographer</span>
        </a>
      </div>
    </div>

    <!-- Editorial photo badge in bottom right -->
    <div class="hero-meta">
      <span class="meta-label">Featured Frame</span>
      <span class="meta-title">{heroPhotograph.title}</span>
      <span class="meta-loc">{heroPhotograph.location}</span>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: calc(90vh - 4.5rem);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: var(--bg-dark);
    color: var(--text-light);
  }

  @media (min-width: 1024px) {
    .hero-section {
      min-height: calc(92vh - 4.5rem);
    }
  }

  .hero-image-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  /* Scrim overlay: subtle gradient to ensure text contrast while retaining full image clarity */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(25, 28, 23, 0.4) 0%,
      rgba(25, 28, 23, 0.55) 50%,
      rgba(25, 28, 23, 0.85) 100%
    );
  }

  @media (min-width: 768px) {
    .hero-scrim {
      background: linear-gradient(
        to right,
        rgba(25, 28, 23, 0.78) 0%,
        rgba(25, 28, 23, 0.5) 45%,
        rgba(25, 28, 23, 0.3) 100%
      );
    }
  }

  .hero-content-wrapper {
    position: relative;
    z-index: 2;
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-3xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: calc(85vh - 4.5rem);
  }

  .hero-content {
    max-width: 680px;
    margin-top: auto;
    margin-bottom: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .eyebrow-line {
    width: 32px;
    height: 1px;
    background-color: var(--accent-olive);
  }

  .eyebrow-text {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #d4a84b;
    text-shadow: 0 1px 6px rgba(0,0,0,0.3);
  }

  .hero-title {
    color: var(--text-light);
    font-size: clamp(2.6rem, 6.5vw, 5.2rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.45);
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 1.4vw, 1.3rem);
    color: var(--bg-secondary);
    line-height: 1.6;
    max-width: 520px;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .hero-btn-secondary {
    border-color: rgba(245, 243, 236, 0.4);
    color: var(--text-light);
    background-color: rgba(37, 41, 33, 0.3);
    backdrop-filter: blur(4px);
  }

  .hero-btn-secondary:hover {
    border-color: var(--text-light);
    background-color: rgba(245, 243, 236, 0.15);
    color: var(--text-light);
  }

  /* Photo badge */
  .hero-meta {
    align-self: flex-end;
    display: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    font-size: 0.75rem;
    color: var(--text-light-muted);
    border-right: 2px solid var(--accent-olive);
    padding-right: 0.75rem;
    margin-top: var(--space-lg);
  }

  @media (min-width: 640px) {
    .hero-meta {
      display: flex;
    }
  }

  .meta-label {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.68rem;
    color: var(--accent-olive);
  }

  .meta-title {
    color: var(--text-light);
    font-weight: 500;
  }
</style>

