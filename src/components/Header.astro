---
import { siteConfig } from '../data/site';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class={`site-header ${transparent ? 'is-transparent' : ''}`} id="site-header">
  <div class="container header-inner">
    <!-- Brand Wordmark -->
    <a href="/" class="brand-link" aria-label="photo.pichi.ra homepage">
      <span class="brand-wordmark">{siteConfig.brandName}</span>
      <span class="brand-sub">nature • wildlife</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul class="nav-list">
        {siteConfig.nav.map((item) => {
          const isActive = item.href === '/' 
            ? currentPath === '/' 
            : currentPath.startsWith(item.href);
          return (
            <li class="nav-item">
              <a
                href={item.href}
                class={`nav-link ${isActive ? 'is-active' : ''}`}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.label}
                {item.external && (
                  <svg class="external-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Mobile Menu Button -->
    <button
      type="button"
      class="mobile-toggle"
      id="mobile-toggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <span class="hamburger-box">
        <span class="hamburger-inner"></span>
      </span>
    </button>
  </div>
</header>

<!-- Mobile Drawer Backdrop & Menu (Outside <header> so backdrop-filter never traps it) -->
<div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop" aria-hidden="true"></div>
<div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
  <div class="drawer-content">
    <nav class="mobile-nav" aria-label="Mobile navigation">
      <ul class="mobile-nav-list">
        {siteConfig.nav.map((item) => {
          const isActive = item.href === '/' 
            ? currentPath === '/' 
            : currentPath.startsWith(item.href);
          return (
            <li class="mobile-nav-item">
              <a
                href={item.href}
                class={`mobile-nav-link ${isActive ? 'is-active' : ''}`}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                <span class="mobile-nav-text">{item.label}</span>
                {item.external && <span class="mobile-nav-tag">Instagram</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="drawer-footer">
      <p class="drawer-quote">"Exploring the natural world, one frame at a time."</p>
      <p class="drawer-sub">@photo.pichi.ra</p>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background-color: rgba(245, 243, 236, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border-subtle);
    transition: background-color var(--transition-normal), border-color var(--transition-normal);
  }

  .site-header.is-transparent {
    background-color: rgba(245, 243, 236, 0.9);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
  }

  /* Brand */
  .brand-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text-primary);
    transition: opacity var(--transition-fast);
  }

  .brand-link:hover {
    color: var(--text-primary);
    opacity: 0.85;
  }

  .brand-wordmark {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--text-primary);
  }

  .brand-sub {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 1px;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    text-transform: uppercase;
    padding: 0.4rem 0;
    position: relative;
    transition: color var(--transition-fast);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 1.5px;
    background-color: var(--accent-olive);
    transition: width var(--transition-normal);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--accent-forest);
  }

  .nav-link.is-active::after,
  .nav-link:hover::after {
    width: 100%;
  }

  .external-icon {
    opacity: 0.6;
    margin-top: -2px;
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-primary);
    z-index: 1001;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  @media (min-width: 768px) {
    .mobile-toggle {
      display: none;
    }
  }

  .hamburger-box {
    width: 26px;
    height: 20px;
    position: relative;
    display: block;
    pointer-events: none;
  }

  .hamburger-inner,
  .hamburger-inner::before,
  .hamburger-inner::after {
    display: block;
    width: 26px;
    height: 2px;
    background-color: var(--text-primary);
    position: absolute;
    left: 0;
    border-radius: 2px;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, background-color 0.2s ease;
  }

  .hamburger-inner {
    top: 50%;
    transform: translateY(-50%);
  }

  .hamburger-inner::before {
    content: '';
    top: -7px;
  }

  .hamburger-inner::after {
    content: '';
    top: 7px;
    bottom: auto;
  }

  /* Open State: morph smoothly into an X */
  .mobile-toggle[aria-expanded="true"] .hamburger-inner {
    background-color: transparent !important;
  }

  .mobile-toggle[aria-expanded="true"] .hamburger-inner::before {
    transform: translateY(7px) rotate(45deg);
    background-color: var(--text-primary);
  }

  .mobile-toggle[aria-expanded="true"] .hamburger-inner::after {
    transform: translateY(-7px) rotate(-45deg);
    background-color: var(--text-primary);
  }

  /* Mobile Drawer Backdrop */
  .mobile-drawer-backdrop {
    position: fixed;
    inset: 0;
    top: 4.5rem;
    background-color: rgba(20, 23, 18, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 998;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, visibility 0.25s;
  }

  .mobile-drawer-backdrop.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    top: 4.5rem;
    left: 0;
    right: 0;
    height: calc(100vh - 4.5rem);
    height: calc(100dvh - 4.5rem);
    background-color: var(--bg-primary);
    z-index: 999;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    border-top: 1px solid var(--border-subtle);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
    transform: translateY(-10px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, visibility 0.25s;
  }

  .mobile-drawer.is-open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .drawer-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: calc(100vh - 4.5rem);
    min-height: calc(100dvh - 4.5rem);
    padding: var(--space-xl) var(--gutter) var(--space-2xl) var(--gutter);
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-serif);
    font-size: 1.85rem;
    color: var(--text-primary);
    text-decoration: none;
    padding: var(--space-xs) 0;
    border-bottom: 1px solid var(--border-subtle);
    touch-action: manipulation;
  }

  .mobile-nav-link.is-active {
    color: var(--accent-forest);
    border-bottom-color: var(--accent-forest);
  }

  .mobile-nav-tag {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-olive);
    background-color: var(--bg-secondary);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .drawer-footer {
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border-subtle);
    margin-top: var(--space-xl);
  }

  .drawer-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  .drawer-sub {
    font-size: 0.82rem;
    color: var(--accent-olive);
    margin-top: 0.35rem;
    letter-spacing: 0.04em;
  }
</style>

<script>
  function setupMobileMenu() {
    const toggle = document.getElementById('mobile-toggle') as HTMLButtonElement | null;
    const drawer = document.getElementById('mobile-drawer') as HTMLElement | null;
    const backdrop = document.getElementById('mobile-drawer-backdrop') as HTMLElement | null;
    if (!toggle || !drawer) return;

    if (toggle.dataset.menuInit === 'true') return;
    toggle.dataset.menuInit = 'true';

    const toggleBtn = toggle;
    const drawerMenu = drawer;

    function openMenu() {
      toggleBtn.setAttribute('aria-expanded', 'true');
      drawerMenu.setAttribute('aria-hidden', 'false');
      drawerMenu.classList.add('is-open');
      backdrop?.classList.add('is-open');
      document.documentElement.classList.add('menu-open');
      document.body.classList.add('menu-open');
    }

    function closeMenu() {
      toggleBtn.setAttribute('aria-expanded', 'false');
      drawerMenu.setAttribute('aria-hidden', 'true');
      drawerMenu.classList.remove('is-open');
      backdrop?.classList.remove('is-open');
      document.documentElement.classList.remove('menu-open');
      document.body.classList.remove('menu-open');
    }

    function toggleMenu(e?: Event) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    toggleBtn.addEventListener('click', toggleMenu);
    backdrop?.addEventListener('click', closeMenu);

    // Close on drawer link click
    drawerMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Close on Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileMenu);
  } else {
    setupMobileMenu();
  }
  document.addEventListener('astro:after-swap', () => {
    const toggle = document.getElementById('mobile-toggle');
    if (toggle) toggle.removeAttribute('data-menu-init');
    setupMobileMenu();
  });
</script>
