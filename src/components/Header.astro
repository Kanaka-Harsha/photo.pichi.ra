---
import { siteConfig } from '../data/site';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class={`site-header ${transparent ? 'is-transparent' : ''}`} id="site-header">
  <div class="container header-inner">
    <!-- Brand Wordmark -->
    <a href="/" class="brand-link" aria-label="photo.pichi.ra homepage">
      <span class="brand-wordmark">{siteConfig.brandName}</span>
      <span class="brand-sub">nature • wildlife</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul class="nav-list">
        {siteConfig.nav.map((item) => {
          const isActive = item.href === '/' 
            ? currentPath === '/' 
            : currentPath.startsWith(item.href);
          return (
            <li class="nav-item">
              <a
                href={item.href}
                class={`nav-link ${isActive ? 'is-active' : ''}`}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.label}
                {item.external && (
                  <svg class="external-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Mobile Menu Button -->
    <button
      type="button"
      class="mobile-toggle"
      id="mobile-toggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <span class="hamburger-box">
        <span class="hamburger-inner"></span>
      </span>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="drawer-content">
      <nav class="mobile-nav" aria-label="Mobile navigation">
        <ul class="mobile-nav-list">
          {siteConfig.nav.map((item) => {
            const isActive = item.href === '/' 
              ? currentPath === '/' 
              : currentPath.startsWith(item.href);
            return (
              <li class="mobile-nav-item">
                <a
                  href={item.href}
                  class={`mobile-nav-link ${isActive ? 'is-active' : ''}`}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  <span class="mobile-nav-text">{item.label}</span>
                  {item.external && <span class="mobile-nav-tag">Instagram</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <div class="drawer-footer">
        <p class="drawer-quote">"Exploring the natural world, one frame at a time."</p>
        <p class="drawer-sub">@photo.pichi.ra</p>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background-color: rgba(245, 243, 236, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border-subtle);
    transition: background-color var(--transition-normal), border-color var(--transition-normal);
  }

  .site-header.is-transparent {
    background-color: rgba(245, 243, 236, 0.9);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
  }

  /* Brand */
  .brand-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text-primary);
    transition: opacity var(--transition-fast);
  }

  .brand-link:hover {
    color: var(--text-primary);
    opacity: 0.85;
  }

  .brand-wordmark {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--text-primary);
  }

  .brand-sub {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 1px;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    text-transform: uppercase;
    padding: 0.4rem 0;
    position: relative;
    transition: color var(--transition-fast);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 1.5px;
    background-color: var(--accent-olive);
    transition: width var(--transition-normal);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--accent-forest);
  }

  .nav-link.is-active::after,
  .nav-link:hover::after {
    width: 100%;
  }

  .external-icon {
    opacity: 0.6;
    margin-top: -2px;
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-primary);
    z-index: 110;
  }

  @media (min-width: 768px) {
    .mobile-toggle {
      display: none;
    }
  }

  .hamburger-box {
    width: 24px;
    height: 18px;
    position: relative;
    display: inline-block;
  }

  .hamburger-inner,
  .hamburger-inner::before,
  .hamburger-inner::after {
    width: 24px;
    height: 2px;
    background-color: var(--text-primary);
    position: absolute;
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  .hamburger-inner {
    top: 50%;
    transform: translateY(-50%);
  }

  .hamburger-inner::before {
    content: '';
    top: -7px;
  }

  .hamburger-inner::after {
    content: '';
    bottom: -7px;
  }

  /* Open State */
  .mobile-toggle[aria-expanded="true"] .hamburger-inner {
    background-color: transparent;
  }

  .mobile-toggle[aria-expanded="true"] .hamburger-inner::before {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-toggle[aria-expanded="true"] .hamburger-inner::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    top: 4.5rem;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--bg-primary);
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
    transition: transform var(--transition-normal), opacity var(--transition-normal);
    z-index: 105;
    overflow-y: auto;
    border-top: 1px solid var(--border-subtle);
  }

  .mobile-drawer.is-open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .drawer-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: calc(100vh - 4.5rem);
    padding: var(--space-2xl) var(--gutter);
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-serif);
    font-size: 1.85rem;
    color: var(--text-primary);
    text-decoration: none;
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--border-subtle);
  }

  .mobile-nav-link.is-active {
    color: var(--accent-forest);
    border-bottom-color: var(--accent-forest);
  }

  .mobile-nav-tag {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-olive);
    background-color: var(--bg-secondary);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .drawer-footer {
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--border-subtle);
  }

  .drawer-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  .drawer-sub {
    font-size: 0.82rem;
    color: var(--accent-olive);
    margin-top: 0.35rem;
    letter-spacing: 0.04em;
  }
</style>

<script>
  function setupMobileMenu() {
    const toggle = document.getElementById('mobile-toggle');
    const drawer = document.getElementById('mobile-drawer');
    if (!toggle || !drawer) return;

    function toggleMenu() {
      if (!toggle || !drawer) return;
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      drawer.setAttribute('aria-hidden', String(isExpanded));
      drawer.classList.toggle('is-open', !isExpanded);
      document.body.style.overflow = !isExpanded ? 'hidden' : '';
    }

    toggle.addEventListener('click', toggleMenu);

    // Close on drawer link click
    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        if (toggle && toggle.getAttribute('aria-expanded') === 'true') {
          toggleMenu();
        }
      });
    });

    // Close on Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle && toggle.getAttribute('aria-expanded') === 'true') {
        toggleMenu();
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
