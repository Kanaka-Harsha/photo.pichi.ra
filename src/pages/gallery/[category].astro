---
import MainLayout from '../../layouts/MainLayout.astro';
import GalleryFilter from '../../components/GalleryFilter.astro';
import PhotographCard from '../../components/PhotographCard.astro';
import { getPhotographsByCategory } from '../../data/photographs';
import { siteConfig } from '../../data/site';
import type { Category } from '../../types/photograph';

export async function getStaticPaths() {
  const categories: Array<{ slug: 'wildlife' | 'nature' | 'landscapes' | 'creative' | 'portrait'; name: string; description: string }> = [
    {
      slug: 'landscapes',
      name: 'Landscapes',
      description: 'Morning light in Alleppey, misty hills in Munnar, beach waves, and open skies.'
    },
    {
      slug: 'wildlife',
      name: 'Wildlife',
      description: 'Little moments with animals and birds — cranes, ducks, goats, and more — spotted while out on trips.'
    },
    {
      slug: 'nature',
      name: 'Nature',
      description: 'Flowers, green leaves, and forest textures you notice when you slow down and look properly.'
    },
    {
      slug: 'creative',
      name: 'Creative Edits',
      description: 'Playing around with candlelight, warm fire tones, shadows, and color experiments in Lightroom.'
    },
    {
      slug: 'portrait',
      name: 'Portraits',
      description: 'Portraits of friends, outdoor lighting tests, and edits practiced on free RAW files.'
    }
  ];

  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: { categoryInfo: cat }
  }));
}

const { category } = Astro.params;
const { categoryInfo } = Astro.props;

const categoryPhotos = getPhotographsByCategory(category as Category);
---

<MainLayout
  title={`${categoryInfo.name} | ${siteConfig.brandName}`}
  description={categoryInfo.description}
>
  <div class="category-page">
    <div class="container">
      <!-- Category Header -->
      <header class="category-header">
        <a href="/gallery/" class="back-link">
          <span aria-hidden="true">&larr;</span>
          <span>Back to All Collections</span>
        </a>
        <h1 class="cat-page-title">{categoryInfo.name}</h1>
        <p class="cat-page-lead">{categoryInfo.description}</p>
      </header>

      <!-- Category Filter Bar -->
      <GalleryFilter activeCategory={category} />

      <!-- Multi-Column Masonry Grid -->
      <div class="gallery-masonry" id="gallery-grid">
        {categoryPhotos.map((photo, index) => (
          <div class="gallery-grid-item" data-category={photo.category}>
            <PhotographCard photo={photo} priority={index < 4} />
          </div>
        ))}
      </div>

      <!-- Empty State -->
      {categoryPhotos.length === 0 && (
        <div class="empty-state">
          <h3>No photographs yet in this collection</h3>
          <p>New frames are currently in development.</p>
          <a href="/gallery/" class="btn btn-primary" style="margin-top: 1rem;">View all photographs</a>
        </div>
      )}
    </div>
  </div>
</MainLayout>

<style>
  .category-page {
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-4xl);
    background-color: var(--bg-primary);
  }

  .category-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--space-2xl) auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-olive);
    margin-bottom: var(--space-sm);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--accent-forest);
  }

  .cat-page-title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    color: var(--text-primary);
    line-height: 1.1;
  }

  .cat-page-lead {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-top: var(--space-sm);
    line-height: 1.65;
  }

  /* Multi-Column Masonry Grid */
  .gallery-masonry {
    column-count: 1;
    column-gap: var(--space-lg);
  }

  @media (min-width: 640px) {
    .gallery-masonry {
      column-count: 2;
      column-gap: var(--space-xl);
    }
  }

  @media (min-width: 1080px) {
    .gallery-masonry {
      column-count: 3;
      column-gap: var(--space-2xl);
    }
  }

  .gallery-grid-item {
    break-inside: avoid;
    margin-bottom: var(--space-xl);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-4xl) 0;
    color: var(--text-muted);
  }

  .empty-state h3 {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    color: var(--text-primary);
  }
</style>
